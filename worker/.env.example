# Copy file này thành .env:   cp .env.example .env   rồi điền.
# File .env đã nằm trong .gitignore, KHÔNG bao giờ bị đẩy lên GitHub.
# ⚠️ CHỈ dùng private key của VÍ FARM RIÊNG, không phải ví chính.

# Private key ví farm (bắt đầu bằng 0x, 66 ký tự)
PRIVATE_KEY=

# Tên hiển thị của ví trên web (địa chỉ chỉ hiện dạng rút gọn)
WALLET_LABEL=Ví farm 1

# (tuỳ chọn) Bot Telegram để báo kết quả sau mỗi lần farm
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Tinh chỉnh (để trống = mặc định) ----
# Số hành động mỗi lần chạy (ngẫu nhiên trong khoảng)
ARC_MIN_ACTIONS=2
ARC_MAX_ACTIONS=4
# Nghỉ giữa các hành động, giây (ngẫu nhiên trong khoảng)
ARC_MIN_DELAY=30
ARC_MAX_DELAY=240
# Tỉ lệ bỏ qua cả ngày cho giống người thật (0 - 1)
SKIP_CHANCE=0.1
# Không farm nếu số dư USDC dưới mức này
ARC_MIN_BALANCE=1

# RPC (để trống = RPC chính thức của Circle)
ARC_RPC=
